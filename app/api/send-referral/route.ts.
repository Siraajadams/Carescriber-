import { NextRequest, NextResponse } from "next/server";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";

type AttachmentInput = {
  fileName?: string;
  signedUrl?: string | null;
};

type SendReferralBody = {
  to?: string;
  recipientName?: string;
  patientName?: string;
  referralNumber?: string;
  subject?: string;
  html?: string;

  // Generated referral PDF from app/referral/page.tsx
  pdfBase64?: string;
  pdfFileName?: string;

  // Clinical photos/documents stored in Supabase
  attachments?: AttachmentInput[];
};

function isValidEmail(value: string) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
}

async function fetchAttachmentAsBase64(url: string) {
  const response = await fetch(url, {
    cache: "no-store",
  });

  if (!response.ok) {
    throw new Error(
      `Could not download attachment. HTTP ${response.status}`,
    );
  }

  const arrayBuffer = await response.arrayBuffer();

  return Buffer.from(arrayBuffer).toString("base64");
}

export async function POST(req: NextRequest) {
  try {
    const resendApiKey =
      process.env.RESEND_API_KEY;

    if (!resendApiKey) {
      return NextResponse.json(
        {
          success: false,
          error:
            "RESEND_API_KEY is not configured in Vercel.",
        },
        { status: 500 },
      );
    }

    const body =
      (await req.json()) as SendReferralBody;

    const to = (body.to || "").trim();

    if (!to) {
      return NextResponse.json(
        {
          success: false,
          error:
            "Receiving clinician email address is required.",
        },
        { status: 400 },
      );
    }

    if (!isValidEmail(to)) {
      return NextResponse.json(
        {
          success: false,
          error:
            "Receiving clinician email address is invalid.",
        },
        { status: 400 },
      );
    }

    if (!body.html?.trim()) {
      return NextResponse.json(
        {
          success: false,
          error:
            "Referral content is missing.",
        },
        { status: 400 },
      );
    }

    /*
      =====================================================
      BUILD EMAIL ATTACHMENTS
      =====================================================

      1. Generated referral PDF
      2. Clinical photos / documents from Supabase Storage
    */

    const emailAttachments: {
      filename: string;
      content: string;
    }[] = [];

    /*
      -----------------------------------------------------
      1. REFERRAL PDF
      -----------------------------------------------------
    */

    if (body.pdfBase64) {
      const cleanPdfBase64 =
        body.pdfBase64.replace(
          /^data:application\/pdf;base64,/,
          "",
        );

      emailAttachments.push({
        filename:
          body.pdfFileName ||
          `CareScriber-Referral-${
            body.referralNumber ||
            "Referral"
          }.pdf`,

        content: cleanPdfBase64,
      });
    }

    /*
      -----------------------------------------------------
      2. USER-UPLOADED CLINICAL ATTACHMENTS
      -----------------------------------------------------

      Signed Supabase URLs are downloaded server-side
      and converted to base64 for Resend.
    */

    for (
      const attachment of
        body.attachments || []
    ) {
      if (
        !attachment.fileName ||
        !attachment.signedUrl
      ) {
        continue;
      }

      try {
        const content =
          await fetchAttachmentAsBase64(
            attachment.signedUrl,
          );

        emailAttachments.push({
          filename:
            attachment.fileName,

          content,
        });
      } catch (attachmentError) {
        /*
          Do not cancel the entire referral email
          because one optional attachment failed.

          The failure will be visible in Vercel logs.
        */

        console.error(
          `Could not attach file: ${attachment.fileName}`,
          attachmentError,
        );
      }
    }

    /*
      =====================================================
      FROM EMAIL
      =====================================================

      The sender MUST be a domain/address
      verified in Resend.

      Recommended Vercel variable:

      CARESCRIBER_FROM_EMAIL
      CareScriber <referrals@carescriber.com>
    */

    const fromEmail =
      process.env
        .CARESCRIBER_FROM_EMAIL ||
      process.env.RESEND_FROM_EMAIL ||
      "";

    if (!fromEmail) {
      return NextResponse.json(
        {
          success: false,

          error:
            "CARESCRIBER_FROM_EMAIL or RESEND_FROM_EMAIL is not configured in Vercel.",
        },
        { status: 500 },
      );
    }

    /*
      =====================================================
      EMAIL SUBJECT
      =====================================================
    */

    const patientName =
      body.patientName?.trim() ||
      "Patient";

    const referralNumber =
      body.referralNumber?.trim() ||
      "Medical Referral";

    const subject =
      body.subject?.trim() ||
      `Medical Referral - ${patientName} - ${referralNumber}`;

    /*
      =====================================================
      SEND VIA RESEND
      =====================================================
    */

    const resendResponse =
      await fetch(
        "https://api.resend.com/emails",
        {
          method: "POST",

          headers: {
            Authorization:
              `Bearer ${resendApiKey}`,

            "Content-Type":
              "application/json",
          },

          body: JSON.stringify({
            from: fromEmail,

            to: [to],

            subject,

            html: body.html,

            attachments:
              emailAttachments.length >
              0
                ? emailAttachments
                : undefined,
          }),
        },
      );

    /*
      =====================================================
      READ RESEND RESPONSE
      =====================================================
    */

    const resendData =
      await resendResponse
        .json()
        .catch(() => ({}));

    if (!resendResponse.ok) {
      console.error(
        "Resend referral email error:",
        resendData,
      );

      return NextResponse.json(
        {
          success: false,

          error:
            resendData?.message ||
            resendData?.error ||
            "Resend rejected the referral email.",

          details: resendData,
        },
        {
          status:
            resendResponse.status ||
            500,
        },
      );
    }

    /*
      =====================================================
      SUCCESS LOG
      =====================================================
    */

    console.log(
      "Referral email sent successfully",
      {
        referralNumber,
        patientName,
        recipient: to,
        resendId:
          resendData?.id || null,
        attachmentsSent:
          emailAttachments.length,
      },
    );

    /*
      =====================================================
      RETURN SUCCESS TO REFERRAL PAGE
      =====================================================
    */

    return NextResponse.json({
      success: true,

      message:
        "Referral sent successfully.",

      emailId:
        resendData?.id || null,

      referralNumber,

      recipient: to,

      attachmentsSent:
        emailAttachments.length,

      pdfAttached:
        Boolean(body.pdfBase64),
    });
  } catch (error) {
    console.error(
      "Send referral API error:",
      error,
    );

    return NextResponse.json(
      {
        success: false,

        error:
          error instanceof Error
            ? error.message
            : "Could not send referral.",
      },
      { status: 500 },
    );
  }
}
